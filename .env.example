# Copier ce fichier vers .env (jamais versionné, cf. .gitignore) et renseigner
# la clé réelle. Utilisée uniquement par src/veille/enrich/llm.py (AD-7,
# frontière LLM unique) pour générer les accroches en français.
ANTHROPIC_API_KEY=

# Optionnel (Story 1.8) — src/veille/publish.py. Sans cette variable, la
# session `gh` déjà authentifiée localement sert de repli (`gh auth token`) :
# à renseigner seulement si le run doit un jour se faire sans elle (ex.
# futur repli GitHub Actions).
GITHUB_TOKEN=

# Optionnel (Story 3.4) — src/veille/store.py. Distinct de GITHUB_TOKEN
# ci-dessus : vise le dépôt SOURCE (état « déjà vu »), pas le dépôt de
# sortie. Même repli local (`gh auth token`) si absent ; en CI, mappé sur
# le jeton ambiant du job (secrets.GITHUB_TOKEN), pas ce fichier.
SOURCE_GITHUB_TOKEN=
